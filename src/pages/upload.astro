---
// src/pages/upload.astro
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>图片上传器 - Thai Directory</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        background-color: #f8fafc;
        color: #334155;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px;
      }
      .upload-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 36px 32px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
      }
      h1 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 6px;
        color: #0f172a;
        letter-spacing: -0.01em;
      }
      p.subtitle {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 28px;
        line-height: 1.5;
      }
      .form-group {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .file-input-wrapper {
        position: relative;
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 24px 16px;
        text-align: center;
        background: #f8fafc;
        transition: all 0.2s ease;
        cursor: pointer;
      }
      .file-input-wrapper:hover {
        border-color: #94a3b8;
        background: #f1f5f9;
      }
      input[type="file"] {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
      }
      .upload-hint {
        font-size: 13px;
        color: #64748b;
        pointer-events: none;
      }
      .upload-hint span {
        color: #2563eb;
        font-weight: 500;
      }
      button {
        background: #0f172a;
        color: #ffffff;
        border: none;
        padding: 12px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition:
          background 0.2s ease,
          transform 0.1s ease;
      }
      button:hover {
        background: #1e293b;
      }
      button:active {
        transform: scale(0.98);
      }
      button:disabled {
        background: #cbd5e1;
        cursor: not-allowed;
      }
      #status {
        margin-top: 18px;
        font-size: 13px;
        word-break: break-all;
        line-height: 1.5;
        text-align: center;
      }
      .status-success {
        color: #16a34a;
        font-weight: 500;
      }
      .status-error {
        color: #dc2626;
        font-weight: 500;
      }
      .status-loading {
        color: #d97706;
      }
      .preview-box {
        margin-top: 20px;
        max-height: 220px;
        overflow: hidden;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        display: none;
      }
      .preview-box img {
        width: 100%;
        height: auto;
        object-fit: cover;
      }
    </style>
  </head>
  <body>
    <div class="upload-card">
      <h2>上传新图片</h2>

      <!-- 图片名称输入框 -->
      <div class="input-group">
        <label for="img-name">图片名称：</label>
        <input
          type="text"
          id="img-name"
          placeholder="请输入图片名称或描述"
          required
        />
      </div>

      <!-- 图片文件选择框 -->
      <div class="input-group">
        <label for="img-file">选择图片：</label>
        <input type="file" id="img-file" accept="image/*" required />
      </div>

      <button id="upload-btn">确认上传</button>
      <div id="upload-status"></div>
    </div>

    <script>
      const uploadBtn = document.getElementById("upload-btn");
      const imgFileInput = document.getElementById(
        "img-file",
      ) as HTMLInputElement;
      const imgNameInput = document.getElementById(
        "img-name",
      ) as HTMLInputElement;
      const statusEl = document.getElementById("upload-status");

      uploadBtn?.addEventListener("click", async () => {
        const file = imgFileInput.files?.[0];
        const name = imgNameInput.value.trim();

        if (!file) return alert("请选择要上传的图片");
        if (!name) return alert("请输入图片名称");

        const formData = new FormData();
        formData.append("file", file);
        formData.append("name", name);

        try {
          statusEl!.textContent = "正在上传...";
          const res = await fetch("/gallery-api/upload", {
            method: "POST",
            body: formData, // 直接发送 FormData，无需手动设 Content-Type
          });

          if (res.ok) {
            statusEl!.textContent = "✅ 上传成功！";
            imgNameInput.value = "";
            imgFileInput.value = "";
          } else {
            throw new Error("上传失败");
          }
        } catch (err: any) {
          statusEl!.textContent = `❌ 错误：${err.message}`;
        }
      });
    </script>
  </body>
</html>
