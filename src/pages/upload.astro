---
// src/pages/upload.astro
import AdminLayout from "../layouts/AdminLayout.astro";
import "../styles/admin-custom.css";

export const prerender = false;

// 登录
/*const token = Astro.cookies.get('admin_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}*/
---

<AdminLayout title="上传图片页面">
  <main class="admin-page-wrapper">
    <div class="admin-card">
      <h2 class="title">上传图像</h2>

      <div class="form-group">
        <label for="img-name" class="field-label"
          >图片名称 (仅限英数字、中划线、下划线)</label
        >
        <input
          type="text"
          id="img-name"
          class="custom-input"
          placeholder="image0001"
          autocomplete="off"
          required
        />
      </div>

      <div class="form-group">
        <label class="field-label">选择图片</label>
        <div class="dropzone" id="dropzone">
          <input
            type="file"
            id="img-file"
            accept="image/*"
            class="file-input"
          />
          <div class="dropzone-content">
            <div class="upload-icon">📸</div>
            <p id="file-hint">点击选择图片，或将图片拖拽至此</p>
          </div>
        </div>
      </div>

      <button
        id="upload-btn"
        class="primary-btn"
        style="width: 100%; padding: 13px; margin-top: 5px;">确认上传</button
      >
      <div
        id="upload-status"
        class="status-message"
        style="text-align: center; font-size: 0.85rem; min-height: 20px; margin-top: 10px;"
      >
      </div>

      <a href="/admin" class="back-link">← 返回后台管理主页</a>
    </div>
  </main>

  <script>
    const uploadBtn = document.getElementById("upload-btn");
    const imgFileInput = document.getElementById(
      "img-file",
    ) as HTMLInputElement;
    const imgNameInput = document.getElementById(
      "img-name",
    ) as HTMLInputElement;
    const statusEl = document.getElementById("upload-status");
    const fileHint = document.getElementById("file-hint");

    const validFileNameRegex = /^[a-zA-Z0-9_-]+$/;

    function compressImage(
      file: File,
      maxWidth = 1920,
      maxHeight = 1920,
      quality = 0.85,
    ): Promise<File> {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = (e) => {
          const img = new Image();
          img.src = e.target?.result as string;
          img.onload = () => {
            let { width, height } = img;
            if (width > maxWidth || height > maxHeight) {
              if (width / height > maxWidth / maxHeight) {
                height = Math.round((height * maxWidth) / width);
                width = maxWidth;
              } else {
                width = Math.round((width * maxHeight) / height);
                height = maxHeight;
              }
            }
            const canvas = document.createElement("canvas");
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext("2d");
            if (!ctx) return reject(new Error("Canvas 初始化失败"));
            ctx.drawImage(img, 0, 0, width, height);

            const mimeType = file.type || "image/jpeg";
            canvas.toBlob(
              (blob) => {
                if (!blob) return reject(new Error("图片压缩失败"));
                resolve(
                  new File([blob], file.name, {
                    type: mimeType,
                    lastModified: Date.now(),
                  }),
                );
              },
              mimeType,
              quality,
            );
          };
          img.onerror = (err) => reject(err);
        };
        reader.onerror = (err) => reject(err);
      });
    }

    imgFileInput?.addEventListener("change", () => {
      const file = imgFileInput.files?.[0];
      if (file) {
        const lastDotIndex = file.name.lastIndexOf(".");
        const baseName =
          lastDotIndex !== -1
            ? file.name.substring(0, lastDotIndex)
            : file.name;
        if (imgNameInput) imgNameInput.value = baseName;
        if (fileHint) {
          fileHint.textContent = `已选择: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
          fileHint.style.color = "#214491";
        }
      }
    });

    uploadBtn?.addEventListener("click", async () => {
      const file = imgFileInput.files?.[0];
      const name = imgNameInput.value.trim();

      if (!file) return alert("请选择要上传的图片");
      if (!name) return alert("请输入图片名称");
      if (!validFileNameRegex.test(name)) {
        alert(
          "文件名格式不合法！\n只能包含英文字母、数字、半角横杠(-) 和下划线(_)。",
        );
        return imgNameInput.focus();
      }

      try {
        if (statusEl) {
          statusEl.textContent = "正在自动优化并压缩图片...";
          statusEl.style.color = "#214491";
        }

        let uploadFile = file;
        if (file.size > 1.5 * 1024 * 1024 || file.type.startsWith("image/")) {
          uploadFile = await compressImage(file, 2048, 2048, 0.82);
        }

        if (statusEl)
          statusEl.textContent = `正在上传中 (${(uploadFile.size / 1024).toFixed(0)} KB)...`;

        const formData = new FormData();
        formData.append("file", uploadFile);
        formData.append("name", name);

        const res = await fetch("/gallery-api/upload", {
          method: "POST",
          body: formData,
        });
        const resText = await res.text();

        if (!res.ok)
          throw new Error(`[HTTP ${res.status}] ${resText || res.statusText}`);

        if (statusEl) {
          statusEl.textContent = "上传成功！";
          statusEl.style.color = "#4ea851";
        }
        imgNameInput.value = "";
        imgFileInput.value = "";
        if (fileHint) {
          fileHint.textContent = "点击选择图片，或将图片拖拽至此";
          fileHint.style.color = "rgba(91, 98, 103, 0.7)";
        }
      } catch (err: any) {
        if (statusEl) {
          statusEl.textContent = `上传失败: ${err.message}`;
          statusEl.style.color = "#e55353";
        }
      }
    });
  </script>
</AdminLayout>
