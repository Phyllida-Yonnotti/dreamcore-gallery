---
// src/pages/upload.astro
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>图片上传器 - Thai Directory</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        background-color: #f8fafc;
        color: #334155;
        font-family: system-ui, -apple-system, sans-serif;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px;
      }
      .upload-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 36px 32px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
      }
      h1 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 6px;
        color: #0f172a;
        letter-spacing: -0.01em;
      }
      p.subtitle {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 28px;
        line-height: 1.5;
      }
      .form-group {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .file-input-wrapper {
        position: relative;
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 24px 16px;
        text-align: center;
        background: #f8fafc;
        transition: all 0.2s ease;
        cursor: pointer;
      }
      .file-input-wrapper:hover {
        border-color: #94a3b8;
        background: #f1f5f9;
      }
      input[type="file"] {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
      }
      .upload-hint {
        font-size: 13px;
        color: #64748b;
        pointer-events: none;
      }
      .upload-hint span {
        color: #2563eb;
        font-weight: 500;
      }
      button {
        background: #0f172a;
        color: #ffffff;
        border: none;
        padding: 12px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.1s ease;
      }
      button:hover {
        background: #1e293b;
      }
      button:active {
        transform: scale(0.98);
      }
      button:disabled {
        background: #cbd5e1;
        cursor: not-allowed;
      }
      #status {
        margin-top: 18px;
        font-size: 13px;
        word-break: break-all;
        line-height: 1.5;
        text-align: center;
      }
      .status-success {
        color: #16a34a;
        font-weight: 500;
      }
      .status-error {
        color: #dc2626;
        font-weight: 500;
      }
      .status-loading {
        color: #d97706;
      }
      .preview-box {
        margin-top: 20px;
        max-height: 220px;
        overflow: hidden;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        display: none;
      }
      .preview-box img {
        width: 100%;
        height: auto;
        object-fit: cover;
      }
    </style>
  </head>
  <body>
    <div class="upload-card">
      <h1>上传图片</h1>
      <p class="subtitle">选择文件上传至 Vercel Blob 的 <code>thai/</code> 目录</p>

      <form id="upload-form" class="form-group">
        <div class="file-input-wrapper">
          <input type="file" id="file-input" accept="image/*" required />
          <div class="upload-hint" id="file-hint">
            点击选择 或 将图片拖放到此处
          </div>
        </div>
        <button type="submit" id="submit-btn">开始上传</button>
      </form>

      <div id="status"></div>
      <div id="preview" class="preview-box">
        <img id="preview-img" src="" alt="上传预览" />
      </div>
    </div>

    <script>
      const form = document.getElementById('upload-form') as HTMLFormElement;
      const fileInput = document.getElementById('file-input') as HTMLInputElement;
      const fileHint = document.getElementById('file-hint') as HTMLDivElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const statusDiv = document.getElementById('status') as HTMLDivElement;
      const previewBox = document.getElementById('preview') as HTMLDivElement;
      const previewImg = document.getElementById('preview-img') as HTMLImageElement;

      fileInput.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (file) {
          fileHint.innerHTML = `已选择: <span>${file.name}</span>`;
        }
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const file = fileInput.files?.[0];
        if (!file) return;

        submitBtn.disabled = true;
        statusDiv.className = 'status-loading';
        statusDiv.textContent = '文件上传中...';
        previewBox.style.display = 'none';

        const formData = new FormData();
        formData.append('file', file);

        try {
          const res = await fetch('/api/upload', {
            method: 'POST',
            body: formData,
          });

          const data = await res.json();

          if (res.ok && data.success) {
            statusDiv.className = 'status-success';
            statusDiv.textContent = '🎉 上传成功！';
            
            previewImg.src = data.url;
            previewBox.style.display = 'block';
            form.reset();
            fileHint.innerHTML = '点击选择 或 将图片拖放到此处';
          } else {
            throw new Error(data.error || '上传失败');
          }
        } catch (err: any) {
          statusDiv.className = 'status-error';
          statusDiv.textContent = '错误: ' + err.message;
        } finally {
          submitBtn.disabled = false;
        }
      });
    </script>
  </body>
</html>