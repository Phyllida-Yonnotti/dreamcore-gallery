---
// src/pages/image-dashboard.astro
import AdminLayout from '../layouts/AdminLayout.astro';
import { list } from '@vercel/blob';
import { createClient } from '@supabase/supabase-js';
import { BLOB_PUBLIC_READ_WRITE_TOKEN } from 'astro:env/server';
import '../styles/admin-custom.css';

export const prerender = false;

// 登录
/*const adminToken = Astro.cookies.get('admin_token')?.value;
if (!adminToken) {
  return Astro.redirect('/login');
}*/

const token = BLOB_PUBLIC_READ_WRITE_TOKEN || process.env.BLOB_PUBLIC_READ_WRITE_TOKEN;
if (!token) throw new Error("缺失有效的 BLOB Token");

const IMAGE_REGEX = /\.(jpg|jpeg|png|webp|gif|svg|avif)$/i;

const blobResponse = await list({ prefix: 'thai/', token: token });
let activeImages = blobResponse.blobs.filter(blob => IMAGE_REGEX.test(blob.pathname));

try {
  const supabase = createClient(
    process.env.SUPABASE_URL || import.meta.env.SUPABASE_URL || '',
    process.env.SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY || ''
  );

  const { data: inactiveRows } = await supabase
    .from('gallery_likes')
    .select('img_url')
    .eq('active_flag', false);

  if (inactiveRows) {
    const inactiveUrls = new Set(inactiveRows.map((r: any) => r.img_url));
    activeImages = activeImages.filter(blob => !inactiveUrls.has(blob.url));
  }
} catch (err) {
  console.warn('读取 Supabase active_flag 失败:', err);
}
---

<AdminLayout title="图片管理">
  <header class="dash-header admin-card">
    <div class="header-title">
      <h1>图片管理</h1>
      <p class="subtitle">
        共 {activeImages.length} 张可用图片 | <a href="/upload" class="nav-link">去上传新图片 →</a>
      </p>
    </div>

    <div class="header-actions">
      <button id="select-all-btn" class="secondary-btn">全选 / 反选</button>
      <button id="delete-btn" class="danger-btn" disabled>
        下架选中 (<span id="selected-count">0</span>)
      </button>
    </div>
  </header>

  <main class="image-grid" id="image-grid">
    {
      activeImages.length === 0 ? (
        <div class="empty-state admin-card">`thai/` 目录下暂无展示中的图片</div>
      ) : (
        activeImages.map((img) => {
          const fileName = img.pathname.replace("thai/", "");
          return (
            <div class="img-card admin-card" data-id={img.url} data-name={fileName}>
              <div class="checkbox-wrapper">
                <input type="checkbox" class="card-checkbox" />
              </div>
              <div class="img-wrapper">
                <img src={img.url} alt={fileName} loading="lazy" />
              </div>
              <div class="img-info" title={fileName}>{fileName}</div>
            </div>
          );
        })
      )
    }
  </main>

  <script>
    const cards = document.querySelectorAll<HTMLElement>(".img-card");
    const selectAllBtn = document.getElementById("select-all-btn");
    const deleteBtn = document.getElementById("delete-btn") as HTMLButtonElement;
    const selectedCountEl = document.getElementById("selected-count")!;
    const selectedIds = new Set<string>();

    cards.forEach((card) => {
      const id = card.dataset.id!;
      const checkbox = card.querySelector<HTMLInputElement>(".card-checkbox")!;

      card.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).tagName !== "INPUT") {
          checkbox.checked = !checkbox.checked;
        }

        if (checkbox.checked) {
          selectedIds.add(id);
          card.classList.add("selected");
        } else {
          selectedIds.delete(id);
          card.classList.remove("selected");
        }
        updateUI();
      });
    });

    selectAllBtn?.addEventListener("click", () => {
      const allSelected = selectedIds.size === cards.length;
      cards.forEach((card) => {
        const id = card.dataset.id!;
        const checkbox = card.querySelector<HTMLInputElement>(".card-checkbox")!;
        if (allSelected) {
          selectedIds.clear();
          checkbox.checked = false;
          card.classList.remove("selected");
        } else {
          selectedIds.add(id);
          checkbox.checked = true;
          card.classList.add("selected");
        }
      });
      updateUI();
    });

    function updateUI() {
      selectedCountEl.textContent = selectedIds.size.toString();
      deleteBtn.disabled = selectedIds.size === 0;
    }

    deleteBtn?.addEventListener("click", async () => {
      if (selectedIds.size === 0 || !confirm(`确定要删除选中的 ${selectedIds.size} 张图片吗？`)) return;

      try {
        deleteBtn.disabled = true;
        deleteBtn.textContent = "处理中...";

        const res = await fetch("/gallery-api/delete-soft", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ids: Array.from(selectedIds) }),
        });

        const data = await res.json();
        if (res.ok) {
          alert("删除成功！");
          window.location.reload();
        } else {
          alert(`删除失败: ${data.error || "未知异常"}`);
          deleteBtn.disabled = false;
          updateUI();
        }
      } catch (err: any) {
        alert(`网络请求失败: ${err.message}`);
        deleteBtn.disabled = false;
        updateUI();
      }
    });
  </script>
</AdminLayout>