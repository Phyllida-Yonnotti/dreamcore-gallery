---
import AdminLayout from '../layouts/AdminLayout.astro';
import { list } from '@vercel/blob';
import { neon } from '@neondatabase/serverless';
import { BLOB_PUBLIC_READ_WRITE_TOKEN } from 'astro:env/server';

export const prerender = false;

// 多重获取 Token
const token = BLOB_PUBLIC_READ_WRITE_TOKEN || process.env.BLOB_PUBLIC_READ_WRITE_TOKEN || process.env.BLOB_READ_WRITE_TOKEN;

if (!token) {
  throw new Error("本地环境变量缺失：未读取到任何有效的 BLOB Token，请检查 .env 文件并重启 dev 服务");
}

const IMAGE_REGEX = /\.(jpg|jpeg|png|webp|gif|svg|avif)$/i;

const blobResponse = await list({ 
  prefix: 'thai/', 
  token: token
});

let activeImages = blobResponse.blobs.filter(blob => 
  IMAGE_REGEX.test(blob.pathname)
);

try {
  // 初始化 sql 客户端
  const dbUrl = process.env.POSTGRES_URL || process.env.DATABASE_URL!;
  const sql = neon(dbUrl);

  // Neon 直接返回数据行数组，不再需要解构 { rows }
  const rows = await sql`SELECT img_url, id FROM "gallery-likes" WHERE active_flag = false`;

  const inactiveUrls = new Set(rows.map((r: any) => r.img_url));

  // 过滤掉已下架的图片
  activeImages = activeImages.filter(blob => !inactiveUrls.has(blob.url));
} catch (err) {
  console.warn('读取数据库 active_flag 失败，显示完整 Blob 列表:', err);
}
---

<AdminLayout title="图片管理">
  <!-- 顶部操作栏 -->
  <header class="dash-header admin-card">
    <div class="header-title">
      <h1>图片管理</h1>
      <p class="subtitle">
        共 {activeImages.length} 张可用图片 | <a href="/upload" class="nav-link"
          >去上传新图片 →</a
        >
      </p>
    </div>

    <div class="header-actions">
      <button id="select-all-btn" class="secondary-btn">全选 / 反选</button>
      <button id="delete-btn" class="danger-btn" disabled>
        下架选中 (<span id="selected-count">0</span>)
      </button>
    </div>
  </header>

  <!-- 缩略图平铺网格 -->
  <main class="image-grid" id="image-grid">
    {
      activeImages.length === 0 ? (
        <div class="empty-state admin-card">`thai/` 目录下暂无展示中的图片</div>
      ) : (
        activeImages.map((img) => {
          const fileName = img.pathname.replace("thai/", "");
          return (
            <div
              class="img-card admin-card"
              data-id={img.url}
              data-name={fileName}
            >
              <div class="checkbox-wrapper">
                <input type="checkbox" class="card-checkbox" />
              </div>
              <div class="img-wrapper">
                <img src={img.url} alt={fileName} loading="lazy" />
              </div>
              <div class="img-info" title={fileName}>
                {fileName}
              </div>
            </div>
          );
        })
      )
    }
  </main>

  <style>
    .dash-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
      flex-wrap: wrap;
      gap: 15px;
    }

    .header-title h1 {
      margin: 0;
      font-size: 1.3rem;
      color: #1b4374;
      letter-spacing: 1.5px;
      font-weight: 500;
    }

    .subtitle {
      margin: 5px 0 0 0;
      font-size: 0.85rem;
      color: rgba(91, 98, 103, 0.75);
    }

    .nav-link {
      color: #214491;
      text-decoration: none;
      font-weight: 500;
    }

    .nav-link:hover {
      text-decoration: underline;
    }

    .header-actions {
      display: flex;
      gap: 12px;
    }

    .image-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 18px;
    }

    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 60px 0;
      color: rgba(91, 98, 103, 0.6);
    }

    .img-card {
      position: relative;
      padding: 0 !important;
      overflow: hidden;
      cursor: pointer;
      transition: all 0.25s ease;
      border: 1px solid rgba(10, 106, 126, 0.2);
    }

    .img-card:hover {
      border-color: #1b4374;
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(10, 106, 126, 0.15);
    }

    .img-card.selected {
      border-color: #e55353;
      box-shadow: 0 0 12px rgba(229, 83, 83, 0.3);
      background: rgba(229, 83, 83, 0.05);
    }

    .checkbox-wrapper {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 5;
    }

    .card-checkbox {
      width: 18px;
      height: 18px;
      accent-color: #e55353;
      cursor: pointer;
    }

    .img-wrapper {
      width: 100%;
      height: 140px;
      overflow: hidden;
      background: #e1e8ed;
    }

    .img-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .img-card:hover .img-wrapper img {
      transform: scale(1.05);
    }

    .img-info {
      padding: 10px;
      font-size: 0.8rem;
      color: #1b4374;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-align: center;
      background: rgba(244, 250, 250, 0.9);
    }
  </style>

  <script>
    const cards = document.querySelectorAll<HTMLElement>(".img-card");
    const selectAllBtn = document.getElementById("select-all-btn");
    const deleteBtn = document.getElementById(
      "delete-btn",
    ) as HTMLButtonElement;
    const selectedCountEl = document.getElementById("selected-count")!;

    const selectedIds = new Set<string>();

    cards.forEach((card) => {
      const id = card.dataset.id!;
      const checkbox = card.querySelector<HTMLInputElement>(".card-checkbox")!;

      card.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).tagName !== "INPUT") {
          checkbox.checked = !checkbox.checked;
        }

        if (checkbox.checked) {
          selectedIds.add(id);
          card.classList.add("selected");
        } else {
          selectedIds.delete(id);
          card.classList.remove("selected");
        }

        updateUI();
      });
    });

    selectAllBtn?.addEventListener("click", () => {
      const allSelected = selectedIds.size === cards.length;

      cards.forEach((card) => {
        const id = card.dataset.id!;
        const checkbox =
          card.querySelector<HTMLInputElement>(".card-checkbox")!;

        if (allSelected) {
          selectedIds.clear();
          checkbox.checked = false;
          card.classList.remove("selected");
        } else {
          selectedIds.add(id);
          checkbox.checked = true;
          card.classList.add("selected");
        }
      });

      updateUI();
    });

    function updateUI() {
      selectedCountEl.textContent = selectedIds.size.toString();
      deleteBtn.disabled = selectedIds.size === 0;
    }

    deleteBtn?.addEventListener("click", async () => {
      if (selectedIds.size === 0) return;

      const confirmMsg = `确定要删除选中的 ${selectedIds.size} 张图片吗？\n`;
      if (!confirm(confirmMsg)) return;

      try {
        deleteBtn.disabled = true;
        deleteBtn.textContent = "处理中...";

        const res = await fetch("/gallery-api/delete-soft", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ids: Array.from(selectedIds) }),
        });

        const data = await res.json();

        if (res.ok) {
          alert("删除成功！");
          window.location.reload();
        } else {
          alert(`删除失败: ${data.error || "未知异常"}`);
          deleteBtn.disabled = false;
          updateUI();
        }
      } catch (err: any) {
        alert(`网络请求失败: ${err.message}`);
        deleteBtn.disabled = false;
        updateUI();
      }
    });
  </script>
</AdminLayout>
