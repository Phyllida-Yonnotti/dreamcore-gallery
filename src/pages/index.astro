---
import Layout from '../layouts/Layout.astro';

const IMAGE_A_URL = "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/dfa5RplDdfaAgd.png";
const SUBTITLE_TEXT_URL = "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/oiTru6Rwtjlsa.png";
const BG_URL = "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/fd8efdE3dg.png";
---

<!-- 将 Layout 当作标签包裹住页面的具体内容 -->
<Layout title="Thai Photo Gallery">
  <div class="app-container">
    <!-- 图片 A 封面层 -->
    <div id="splash" class="splash-screen">
      <img src={IMAGE_A_URL} alt="Splash Image" fetchpriority="high"/>
    </div>

    <!-- 背景 -->
    <div id="bg-blur" class="bg-blur" style={`background-image: url('${BG_URL}');`}></div>

    <!-- subtitle -->
    <div class="subtitle-container">
      <img src={SUBTITLE_TEXT_URL} alt="subtitle" />
    </div>
    
    <!-- 居中照片 -->
    <div class="gallery-container">
      <div class="card">
        <div class="image-wrapper">
          <img id="main-img" src="" alt="Gallery Image" loading="eager"/>
        </div>
        <div class="controls">
          <button id="prev-btn" class="btn" aria-label="Previous">
            <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button id="next-btn" class="btn" aria-label="Next">
            <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>