---
import Layout from "../layouts/Layout.astro";

const GATE_URL =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/image_51tnww51tnww51tn-removebg-preview.png";
const SUBTITLE_TEXT_URL =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/oiTru6Rwtjlsa.png";
const BG_URL_DESKTOP =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/IMG_9871_04.jpg";
const BG_URL_MOBILE =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/IMG_9871_05.jpg";
const PREV_BTN_URL =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/previous-icon.png";
const NEXT_BTN_URL =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/next-icon.png";
const WORD_URL =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/word.png";
const LINE_URL =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/line.png";
const SIGN_URL =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/sign.png";
const BANNER_MOBILE =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/IMG_0068.png";
const BANNER_DESKTOP =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/IMG_0069.png";
const LEAF_LEFT_01_URL =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/leaf-01.png";
const LEAF_RIGHT_02_URL =
  "https://hppuxb7qepdidfa2.public.blob.vercel-storage.com/parts/leaf-02.png";
---

<!-- 将 Layout 当作标签包裹住页面的具体内容 -->
<Layout title="Thai Photo Gallery">
  <div class="app-container">
    <!-- 封面层 -->
    <div id="splash" class="splash-screen">
      <canvas id="water-canvas"></canvas>
      <div class="splash-hint">
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.-.________<br />
        ----/ \ )_______)<br />
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;( (/()___)<br />
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;()__)<br
        />
        ----\___()_)<br />
      </div>
    </div>

    <!-- 背景 -->
    <div
      id="bg-blur"
      class="bg-blur"
      style={`--bg-desktop: url('${BG_URL_DESKTOP}'); --bg-mobile: url('${BG_URL_MOBILE}');`}
    >
    </div>

    <!-- subtitle -->
    <div class="top-banner-container">
      <img
        src={BANNER_DESKTOP}
        class="top-banner-img desktop-banner"
        alt="Top Banner Desktop"
      />
      <img
        src={BANNER_MOBILE}
        class="top-banner-img mobile-banner"
        alt="Top Banner Mobile"
      />
    </div>

    <!-- 居中照片 -->
    <div class="gallery-container">
      <!-- 1. 背景静止深邃叶墙（仅手机端显示） -->
      <div class="leaf-wall-bg"></div>
      <!-- 2. 中间照片容器 -->
      <div class="card">
        <div class="image-wrapper">
          <img id="main-img" src="" alt="Gallery Image" loading="eager" />
        </div>
      </div>
      <!-- 3. 前景遮挡与穿梭树叶层 -->
      <div class="leaf-overlay">
        <img
          src={LEAF_LEFT_01_URL}
          class="leaf-item leaf-tl"
          alt="leaf"
        />
        <img
          src={LEAF_LEFT_01_URL}
          class="leaf-item leaf-tr"
          alt="leaf"
        />
        <img
          src={LEAF_RIGHT_02_URL}
          class="leaf-item leaf-bl"
          alt="leaf"
        />
        <img
          src={LEAF_RIGHT_02_URL}
          class="leaf-item leaf-br"
          alt="leaf"
        />
      </div>
      <!-- 4. 底部 Liked 控制栏 -->
      <div class="controls">
        <!-- Previous Button -->
        <button id="prev-btn" class="btn" aria-label="Previous">
          <img src={PREV_BTN_URL} alt="Previous" />
        </button>
        <!-- 居中爱心与点赞数结构 -->
        <div class="heart-wrapper">
          <div class="heart-container">
            <input type="checkbox" id="like-checkbox" class="checkbox" />
            <div class="svg-container">
              <svg
                class="svg-outline"
                viewBox="0 0 24 24"
                width="24"
                height="24"
              >
                <path
                  d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                ></path>
              </svg>
              <svg
                class="svg-filled"
                viewBox="0 0 24 24"
                width="24"
                height="24"
              >
                <path
                  d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                ></path>
              </svg>
              <svg
                class="svg-celebrate"
                viewBox="0 0 100 100"
                width="40"
                height="40"
              >
                <polygon points="10,10 20,20"></polygon>
                <polygon points="90,10 80,20"></polygon>
                <polygon points="50,5 50,20"></polygon>
                <polygon points="10,90 20,80"></polygon>
                <polygon points="90,90 80,80"></polygon>
              </svg>
            </div>
          </div>
          <span id="like-count" class="like-count">0</span>
        </div>
        <!-- Next Button -->
        <button id="next-btn" class="btn" aria-label="Next">
          <img src={NEXT_BTN_URL} alt="Next" />
        </button>
      </div>
    </div>
  </div>
</Layout>
