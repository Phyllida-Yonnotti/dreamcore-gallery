---
// 定义组件接接收的属性（如页面标题）
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/gallery.css';
---

<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>
<body>
  <!-- 核心：<slot /> 就像一个占位符，页面传进来的内容都会塞到这里 -->
  <slot />

  <!-- 也可以在这里全局加载通用脚本 -->
  <script src="../scripts/gallery.ts"></script>
</body>
</html>