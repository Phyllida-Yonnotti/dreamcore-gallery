---
// src/layouts/AdminLayout.astro
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="admin-bg"></div>

    <div class="admin-wrapper">
      <slot />
    </div>

    <style>
      body {
        margin: 0;
        min-height: 100vh;
        background: #eff3f8d6;
        color: #1b4374;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }

      .admin-bg {
        position: fixed;
        inset: 0;
        z-index: 1;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.6) 0%, rgba(200, 215, 235, 0.4) 100%);
        pointer-events: none;
      }

      .admin-wrapper {
        position: relative;
        z-index: 10;
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px 20px;
        min-height: 100vh;
        box-sizing: border-box;
      }

      :global(.admin-card) {
        background: rgba(244, 250, 250, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(10, 106, 126, 0.2);
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 10px 30px rgba(10, 106, 126, 0.08);
      }

      :global(.primary-btn) {
        background: linear-gradient(135deg, #517c80 0%, #214491 100%);
        color: #f3ecec;
        border: none;
        border-radius: 8px;
        padding: 10px 18px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 4px 12px rgba(33, 68, 145, 0.2);
      }

      :global(.primary-btn:hover:not(:disabled)) {
        filter: brightness(1.15);
        transform: translateY(-1px);
      }

      :global(.secondary-btn) {
        background: rgba(10, 106, 126, 0.08);
        color: #1b4374;
        border: 1px solid rgba(10, 106, 126, 0.25);
        border-radius: 8px;
        padding: 10px 18px;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.25s ease;
      }

      :global(.secondary-btn:hover) {
        background: rgba(10, 106, 126, 0.15);
      }

      :global(.danger-btn) {
        background: linear-gradient(135deg, #e55353 0%, #a83232 100%);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 18px;
        font-size: 0.9rem;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(229, 83, 83, 0.2);
        transition: all 0.25s ease;
      }

      :global(.danger-btn:hover:not(:disabled)) {
        filter: brightness(1.15);
        transform: translateY(-1px);
      }

      :global(.danger-btn:disabled) {
        opacity: 0.4;
        cursor: not-allowed;
        filter: grayscale(1);
      }
    </style>
  </body>
</html>